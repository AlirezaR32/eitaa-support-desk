# ============================================================================
# Eitaa Support Desk — environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# ============================================================================

# --- app ---
APP_ENV=development                 # development | test | production
APP_NAME=Eitaa Support Desk

# --- secrets (REQUIRED in production) ---
# generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-please-generate-a-long-random-string
# generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-too-generate-a-long-random-string
# generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EITAA_SESSION_ENCRYPTION_KEY=

# --- tokens ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- database ---
# local dev default matches docker compose postgres
DATABASE_URL=postgresql+asyncpg://desk:desk@localhost:5432/eitaa_desk
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- CORS (comma separated; the deployed frontend origin(s)) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- eitaa sync (eitaa-cli has NO event stream -> polling) ---
EITAA_SYNC_INTERVAL=15              # seconds between sync passes
EITAA_SYNC_ENABLED=true
EITAA_SYNC_DIALOG_LIMIT=100
EITAA_SYNC_HISTORY_LIMIT=50
EITAA_SYNC_KINDS=private            # private,group,supergroup,channel
EITAA_API_TIMEOUT=45

# --- workers ---
RUN_SYNC_WORKER=true                # false on API instances when using a dedicated worker
RUN_NOTIFICATION_WORKER=true
NOTIFICATION_UNANSWERED_AFTER_SECONDS=600
NOTIFICATION_WORKER_INTERVAL=60

# --- uploads ---
UPLOADS_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=png,jpg,jpeg,gif,webp,mp3,ogg,oga,opus,wav,m4a,mp4,webm,mov,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,zip,rar,7z,json

# --- rate limiting / security ---
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- optional redis (shared rate limits / horizontal scaling) ---
# REDIS_URL=redis://localhost:6379/0

# --- logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- bootstrap owner (used ONCE when users table is empty) ---
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Owner

# --- frontend (Vite build-time; put in frontend/.env if needed) ---
# VITE_API_BASE_URL=https://api.example.com   # empty = same-origin
